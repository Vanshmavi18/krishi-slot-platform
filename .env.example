# ==============================================================================
# AgriQueue Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your variables before starting the server.
#
# IMPORTANT SECURITY NOTICE:
# - Never commit your real .env file or credentials to Git.
# - MongoDB credentials are used strictly on the Node.js backend.
# - Secrets must NEVER be referenced in frontend client code.
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=development

# JWT Session Authentication Secret (Replace with a strong random 256-bit string in production)
JWT_SECRET=agriqueue_production_jwt_secret_key_2026_secure

# ------------------------------------------------------------------------------
# MongoDB Database Connection String (Required for MongoDB persistence)
# Supports MongoDB Atlas (cloud) or local standalone / replica set instances.
#
# Format:
#   Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/agriqueue?retryWrites=true&w=majority
#   Local:  mongodb://127.0.0.1:27017/agriqueue
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/agriqueue?retryWrites=true&w=majority

# Set to true if testing against a local unauthenticated mongod instance (optional)
ENABLE_LOCAL_MONGO=false

# ------------------------------------------------------------------------------
# Optional Cloud Email Gateway (Gmail SMTP or Resend API for real OTP & alerts)
# ------------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=AgriQueue <onboarding@resend.dev>
